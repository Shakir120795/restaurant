# Copy to .env for local overrides. No secrets are required for this MVP.
# WhatsApp business number in international format WITHOUT '+' (owner-confirmed only).
# Example: VITE_WHATSAPP_NUMBER=919012882895
VITE_WHATSAPP_NUMBER=
# Public site URL used for sitemap / Open Graph (replace on deploy).
VITE_SITE_URL=https://example.com
